# Copy to .env.local for local dev. In production these are set as Vercel
# project environment variables -- never committed, never hardcoded.

# Required. SEC EDGAR's fair-access policy requires a descriptive
# User-Agent with a contact email on every request. Use an email you're
# comfortable being publicly associated with EDGAR traffic (it is sent to
# SEC's servers on every request this app makes).
EDGAR_CONTACT_EMAIL=

# Required for the persistent store: the explanation cache, the daily
# Claude call count, and the per-accession segment data. A Neon Postgres
# connection string, the pooled one -- nothing in the app uses a
# session-level feature, so the unpooled string is not needed, not even to
# create the schema (npm run db:apply).
#
# With this unset the app still runs: EDGAR works, the rules decide, and
# the Claude layer reports itself unavailable rather than spending an
# uncapped budget.
DATABASE_URL=

# Required for the Claude explanation layer. Unset, the "Explained from
# the filings" block reads "Explanations unavailable" and every other part
# of the page renders normally.
ANTHROPIC_API_KEY=

# Optional overrides.
#
# CLAUDE_ENABLED=false is the explicit off switch: no call is made or
# counted, and the page renders complete from the rules alone.
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-opus-5
# The declared daily cap is 50 (see the page footer). This only overrides it.
CLAUDE_DAILY_CAP=50
